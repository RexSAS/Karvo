<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_ridges" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="62dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jost"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/widget_week_short"
            android:textAllCaps="true"
            android:textColor="@color/widget_mist"
            android:textFontWeight="600"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/jost"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0h"
            android:textColor="@color/widget_snow"
            android:textFontWeight="300"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/jost"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_mist"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_add"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:contentDescription="@string/add_lesson"
        android:src="@drawable/widget_add" />
</FrameLayout>
