<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×2 quick overview: this week | this month, in the look of widget_week (mountains bottom-left, gold + bottom-right). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|start"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_ridges" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jost"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="@string/widget_week_short"
                android:textAllCaps="true"
                android:textColor="@color/widget_mist"
                android:textFontWeight="600"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jost"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0h"
                android:textColor="@color/widget_snow"
                android:textFontWeight="300"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/widget_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/jost"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_mist"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- A faint line between the two -->
        <View
            android:layout_width="1dp"
            android:layout_height="64dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="18dp"
            android:background="#338CCBFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_month_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jost"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="@string/widget_month_label"
                android:textAllCaps="true"
                android:textColor="@color/widget_mist"
                android:textFontWeight="600"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_month_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jost"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0h"
                android:textColor="@color/widget_snow"
                android:textFontWeight="300"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/widget_month_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/jost"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_mist"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_add"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="@drawable/widget_add_ripple"
        android:contentDescription="@string/add_lesson"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_add" />
</FrameLayout>
