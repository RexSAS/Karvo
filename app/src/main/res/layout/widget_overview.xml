<?xml version="1.0" encoding="utf-8"?>
<!-- The 4×2 quick overview: this week big on the left (mountains and the gold + under it); on the right, the month,
     today and the season small, and the next event in a little corner like the "Today" widget sketch. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|start"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_ridges" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- This week -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jost"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:text="@string/widget_week_short"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_mist"
                    android:textFontWeight="600"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/jost"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0h"
                    android:textColor="@color/widget_snow"
                    android:textFontWeight="300"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/widget_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jost"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_mist"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_add"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/widget_add_ripple"
                android:contentDescription="@string/add_lesson"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_add" />
        </FrameLayout>

        <!-- A faint line between the two (a FrameLayout: widgets refuse a plain View) -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="18dp"
            android:layout_marginStart="10dp"
            android:background="#338CCBFF" />

        <!-- Small stats and the next event -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_month_label"
                    style="@style/WidgetStatLabel"
                    android:text="@string/widget_month_label" />

                <TextView
                    android:id="@+id/widget_month_hours"
                    style="@style/WidgetStatValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/WidgetStatLabel"
                    android:text="@string/today" />

                <TextView
                    android:id="@+id/widget_today_hours"
                    style="@style/WidgetStatValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/WidgetStatLabel"
                    android:text="@string/widget_season" />

                <TextView
                    android:id="@+id/widget_season_hours"
                    style="@style/WidgetStatValue" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Event corner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="@drawable/widget_event_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp">

                <FrameLayout
                    android:id="@+id/widget_event_bar"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@drawable/widget_event_bar" />

                <TextView
                    android:id="@+id/widget_event_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/jost"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_no_events"
                    android:textColor="@color/widget_snow"
                    android:textFontWeight="500"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_event_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/jost"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_gold"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
