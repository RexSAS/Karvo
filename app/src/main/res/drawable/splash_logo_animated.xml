<?xml version="1.0" encoding="utf-8"?>
<!-- Splash logo (Android 12+), "sunrise on the summit", 1000 ms (the most Android allows): a dark peak appears, first light runs down its two
     faces from the summit while a gold spark follows the carve, then the sun rises.
     At rest this is the finished logo; every animation first jumps to its hidden start. So a phone that does not
     play it ("Remove animations" ends it at once) still shows the logo, never an empty splash.
     The same mark as ic_launcher_foreground: inside the 160dp circle of the 240dp splash icon. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.86"
                android:scaleY="0.86"
                android:translateY="1.5">
                <!-- The peak before sunrise -->
                <path
                    android:name="ghost_lit"
                    android:fillColor="#1C2658"
                    android:pathData="M25,75 L53,28 C61.5,39 62.5,47.5 55,54.5 C48,61 49.5,68 57,75 Z" />
                <path
                    android:name="ghost_shade"
                    android:fillColor="#151D48"
                    android:pathData="M65.07,46.88 L83,75 L63.5,75 C55.5,68.5 54,62.5 60.5,56.5 C63.77,53.45 65.23,50.21 65.07,46.88 Z" />
                <!-- The two faces in first light, uncovered from the summit down -->
                <group>
                    <clip-path
                        android:name="reveal"
                        android:pathData="M0,26 L108,26 L108,77 L0,77 Z" />
                    <path android:pathData="M25,75 L53,28 C61.5,39 62.5,47.5 55,54.5 C48,61 49.5,68 57,75 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:endX="0"
                                android:endY="75"
                                android:startX="0"
                                android:startY="28"
                                android:type="linear">
                                <item android:color="#FFFFE7BF" android:offset="0" />
                                <item android:color="#FFFFFFFF" android:offset="0.3" />
                                <item android:color="#FFDCE6F8" android:offset="1" />
                            </gradient>
                        </aapt:attr>
                    </path>
                    <path android:pathData="M65.07,46.88 L83,75 L63.5,75 C55.5,68.5 54,62.5 60.5,56.5 C63.77,53.45 65.23,50.21 65.07,46.88 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:endX="0"
                                android:endY="75"
                                android:startX="0"
                                android:startY="33.6"
                                android:type="linear">
                                <item android:color="#FFA9D6FF" android:offset="0" />
                                <item android:color="#FF5B8DDC" android:offset="1" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
                <!-- The gold spark that runs down the carve (nothing of it is left at the end) -->
                <path
                    android:name="spark"
                    android:pathData="M54.8,30 C63.5,40.5 64.5,48 57.7,55.5 C51,62.5 52,68.5 60.2,75"
                    android:strokeColor="#F4C06A"
                    android:strokeLineCap="round"
                    android:strokeWidth="1.8"
                    android:trimPathEnd="1"
                    android:trimPathStart="1" />
                <group android:name="sun">
                    <path
                        android:name="sun_disc"
                        android:fillColor="#F4C06A"
                        android:pathData="M27.3,41 a6.2,6.2 0 1,0 12.4,0 a6.2,6.2 0 1,0 -12.4,0 Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="ghost_lit">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="133" android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="ghost_shade">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="133" android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="reveal">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="89"
                    android:propertyName="pathData"
                    android:valueFrom="M0,26 L108,26 L108,26 L0,26 Z"
                    android:valueTo="M0,26 L108,26 L108,26 L0,26 Z"
                    android:valueType="pathType" />
                <objectAnimator
                    android:duration="600"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="pathData"
                    android:valueFrom="M0,26 L108,26 L108,26 L0,26 Z"
                    android:valueTo="M0,26 L108,26 L108,77 L0,77 Z"
                    android:valueType="pathType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="spark">
        <aapt:attr name="android:animation">
            <set>
                <set android:ordering="sequentially">
                    <objectAnimator android:duration="89" android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="0" />
                    <objectAnimator
                        android:duration="467"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="trimPathEnd"
                        android:valueFrom="0"
                        android:valueTo="1" />
                </set>
                <set android:ordering="sequentially">
                    <objectAnimator android:duration="244" android:propertyName="trimPathStart" android:valueFrom="0" android:valueTo="0" />
                    <objectAnimator
                        android:duration="444"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="trimPathStart"
                        android:valueFrom="0"
                        android:valueTo="1" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <target android:name="sun">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:duration="622" android:propertyName="translateY" android:valueFrom="11" android:valueTo="11" />
                <objectAnimator
                    android:duration="378"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="translateY"
                    android:valueFrom="11"
                    android:valueTo="0" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="sun_disc">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:duration="622" android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="0" />
                <objectAnimator android:duration="156" android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
