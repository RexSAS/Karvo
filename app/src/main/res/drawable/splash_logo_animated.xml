<?xml version="1.0" encoding="utf-8"?>
<!-- Splash logo (Android 12+): the peaks rise from the ground, then a gold sun appears. ~800 ms in total. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="sun"
                android:pivotX="38"
                android:pivotY="40"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:fillColor="#E8B964"
                    android:pathData="M33,40 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z" />
            </group>
            <group
                android:name="small_peak"
                android:pivotX="72"
                android:pivotY="76"
                android:scaleY="0">
                <path
                    android:fillColor="#E3F2FD"
                    android:pathData="M72,48 L86,76 L58,76 Z" />
            </group>
            <group
                android:name="main_peak"
                android:pivotX="54"
                android:pivotY="76"
                android:scaleY="0">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M54,30 L82,76 L26,76 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="main_peak">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="350"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="scaleY"
                android:startOffset="100"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="small_peak">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="scaleY"
                android:startOffset="300"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="sun">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="250"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="550"
                    android:valueFrom="0"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="250"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="550"
                    android:valueFrom="0"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
