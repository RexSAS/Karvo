<?xml version="1.0" encoding="utf-8"?>
<!-- Karvo emblem, "the carved peak": a summit split by one ski carve, with the sun at first light.
     In its own colours; where one colour is wanted (Classic theme, share images) it is tinted and stays readable,
     because the carve keeps the two faces apart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="72dp"
    android:height="56dp"
    android:viewportWidth="72"
    android:viewportHeight="56">
    <!-- The mark is drawn on the 108 launcher grid; this fits it to 72 x 56. -->
    <group
        android:scaleX="1.16"
        android:scaleY="1.16"
        android:translateX="-26.64"
        android:translateY="-31.74">
        <path
            android:fillColor="#F4C06A"
            android:pathData="M27.3,41 a6.2,6.2 0 1,0 12.4,0 a6.2,6.2 0 1,0 -12.4,0 Z" />
        <path android:pathData="M25,75 L53,28 C61.5,39 62.5,47.5 55,54.5 C48,61 49.5,68 57,75 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="0"
                    android:endY="75"
                    android:startX="0"
                    android:startY="28"
                    android:type="linear">
                    <item android:color="#FFFFE7BF" android:offset="0" />
                    <item android:color="#FFFFFFFF" android:offset="0.3" />
                    <item android:color="#FFDCE6F8" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:pathData="M56.6,33.6 L83,75 L63.5,75 C55.5,68.5 54,62.5 60.5,56.5 C68,49.5 66,41.5 56.6,33.6 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="0"
                    android:endY="75"
                    android:startX="0"
                    android:startY="33.6"
                    android:type="linear">
                    <item android:color="#FFA9D6FF" android:offset="0" />
                    <item android:color="#FF5B8DDC" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
