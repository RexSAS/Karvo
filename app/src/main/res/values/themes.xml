<resources>
    <!-- Navy window background so the default Alpine Night theme starts without a white flash. -->
    <style name="Theme.MasterSki" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/alpine_night_background</item>
    </style>

    <!-- Launch theme: the splash screen, then Theme.MasterSki. -->
    <style name="Theme.MasterSki.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/alpine_night_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_static</item>
        <item name="postSplashScreenTheme">@style/Theme.MasterSki</item>
    </style>
</resources>
