<resources>
    <!-- Navy window background so the default Alpine Night theme starts without a white flash. -->
    <style name="Theme.Karvo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/alpine_night_background</item>
    </style>

    <!-- Launch theme: the splash screen, then Theme.Karvo. -->
    <style name="Theme.Karvo.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/alpine_night_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/alpine_night_background</item>
        <!-- Android 8 to 11 cannot animate the splash icon: the finished logo, still. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Karvo</item>
    </style>
</resources>
